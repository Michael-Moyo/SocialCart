# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/socialcart?schema=public"

# ─── API Server ──────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001

# ─── Auth / Security ─────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=change_me_to_32_byte_hex_key_here_64chars  # 32 bytes hex = 64 chars

# ─── WhatsApp Business API ───────────────────────────────────────────────────
WHATSAPP_API_VERSION=v19.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_WEBHOOK_SECRET=your_webhook_secret

# ─── Shopify (per-tenant, stored encrypted in DB) ────────────────────────────
# SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_xxx
# SHOPIFY_WEBHOOK_SECRET=your_webhook_secret
# SHOPIFY_API_VERSION=2024-01

# ─── WooCommerce (per-tenant, stored encrypted in DB) ────────────────────────
# WOOCOMMERCE_BASE_URL=https://your-store.com
# WOOCOMMERCE_CONSUMER_KEY=ck_xxx
# WOOCOMMERCE_CONSUMER_SECRET=cs_xxx
# WOOCOMMERCE_WEBHOOK_SECRET=your_webhook_secret

# ─── Odoo (per-tenant, stored encrypted in DB) ───────────────────────────────
# ODOO_BASE_URL=https://your-odoo.com
# ODOO_DATABASE=your_db
# ODOO_USERNAME=admin
# ODOO_PASSWORD=your_password

# ─── ERPNext (per-tenant, stored encrypted in DB) ────────────────────────────
# ERPNEXT_BASE_URL=https://your-erpnext.com
# ERPNEXT_API_KEY=your_api_key
# ERPNEXT_API_SECRET=your_api_secret

# ─── RetailMan (per-tenant, stored encrypted in DB) ──────────────────────────
# RETAILMAN_BASE_URL=https://your-retailman-api.com
# RETAILMAN_API_KEY=your_api_key

# ─── Payments ────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_xxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_xxx

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=admin@yourdomain.com

# ─── Docker compose overrides ────────────────────────────────────────────────
POSTGRES_USER=socialcart
POSTGRES_PASSWORD=changeme
POSTGRES_DB=socialcart
FRONTEND_URL=http://localhost:3000

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
