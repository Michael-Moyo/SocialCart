generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
  SYNCING
}

enum IntegrationType {
  shopify
  woocommerce
  odoo
  erpnext
  retailman
}

enum ProductStatus {
  active
  inactive
  draft
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  paid
  partial
  refunded
  failed
}

enum FulfillmentStatus {
  unfulfilled
  partial
  fulfilled
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  RECOVERED
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  MANUAL
}

enum PaymentLinkStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  BOT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum CampaignType {
  BROADCAST
  DRIP
  ABANDONED_CART
  LOYALTY
  REORDER
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  PAUSED
  CANCELLED
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum TeamRole {
  OWNER
  MANAGER
  AGENT
  SALES_REP
}

enum NotificationChannel {
  IN_APP
  WHATSAPP
  PUSH
}

enum NotificationType {
  NEW_ORDER
  NEW_CONVERSATION
  CONVERSATION_ASSIGNED
  CART_ABANDONED
  CAMPAIGN_COMPLETE
  LOYALTY_TIER_UP
  TEAM_INVITE
  SYSTEM
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Tenant {
  id                    String    @id @default(uuid())
  name                  String
  phone                 String    @unique
  email                 String?   @unique
  passwordHash          String?   // kept for legacy / fallback; primary auth is WhatsApp OTP
  whatsappBusinessId    String?
  whatsappPhoneNumberId String?
  plan                  Plan      @default(FREE)
  isActive              Boolean   @default(true)
  settings              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  integrations      Integration[]
  products          Product[]
  customers         Customer[]
  orders            Order[]
  carts             Cart[]
  conversations     Conversation[]
  campaigns         Campaign[]
  teamMembers       TeamMember[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  paymentLinks      PaymentLink[]

  @@index([phone])
  @@map("tenants")
}

model Integration {
  id            String            @id @default(uuid())
  tenantId      String
  type          IntegrationType
  credentials   String            // AES-256-GCM encrypted JSON
  config        Json?             // non-sensitive config (webhookSecret excluded)
  status        IntegrationStatus @default(ACTIVE)
  lastSyncAt    DateTime?
  syncCount     Int               @default(0)
  errorMessage  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@index([tenantId])
  @@map("integrations")
}

model Product {
  id          String        @id @default(uuid())
  tenantId    String
  externalId  String
  source      IntegrationType
  sku         String
  name        String
  description String?
  price       Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?   @db.Decimal(10, 2)
  currency    String        @default("USD")
  inventory   Int           @default(0)
  images      Json          @default("[]")
  variants    Json          @default("[]")
  categories  String[]
  tags        String[]
  status      ProductStatus @default(active)
  data        Json?         // raw platform data
  syncedAt    DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, source, externalId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([sku])
  @@map("products")
}

model Customer {
  id           String    @id @default(uuid())
  tenantId     String
  phone        String
  name         String
  firstName    String?
  lastName     String?
  email        String?
  tags         String[]  @default([])
  totalOrders  Int       @default(0)
  totalSpent   Decimal   @default(0) @db.Decimal(12, 2)
  currency     String    @default("USD")
  externalId   String?
  platform     IntegrationType?
  defaultAddress Json?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders         Order[]
  carts          Cart[]
  conversations  Conversation[]
  loyaltyAccount LoyaltyAccount?
  paymentLinks   PaymentLink[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([phone])
  @@map("customers")
}

model Order {
  id                String            @id @default(uuid())
  tenantId          String
  externalId        String?
  customerId        String
  source            IntegrationType?
  status            OrderStatus       @default(pending)
  paymentStatus     PaymentStatus     @default(pending)
  fulfillmentStatus FulfillmentStatus @default(unfulfilled)
  subtotal          Decimal           @db.Decimal(12, 2)
  tax               Decimal           @default(0) @db.Decimal(12, 2)
  shipping          Decimal           @default(0) @db.Decimal(12, 2)
  discount          Decimal           @default(0) @db.Decimal(12, 2)
  total             Decimal           @db.Decimal(12, 2)
  currency          String            @default("USD")
  items             Json              // line items array
  shippingAddress   Json?
  billingAddress    Json?
  notes             String?
  tags              String[]          @default([])
  trackingNumber    String?
  trackingUrl       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id])
  paymentLinks PaymentLink[]

  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, status])
  @@index([externalId])
  @@map("orders")
}

model Cart {
  id          String     @id @default(uuid())
  tenantId    String
  customerId  String
  items       Json       @default("[]")
  status      CartStatus @default(ACTIVE)
  abandonedAt DateTime?
  recoveredAt DateTime?
  expiresAt   DateTime?
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId])
  @@index([customerId])
  @@index([status])
  @@index([abandonedAt])
  @@map("carts")
}

model Conversation {
  id               String             @id @default(uuid())
  tenantId         String
  customerId       String
  waNumber         String
  status           ConversationStatus @default(BOT)
  currentFlow      String?
  context          Json               @default("{}")
  assignedTo       String?            // legacy free-text
  assignedMemberId String?            // FK to TeamMember
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer    @relation(fields: [customerId], references: [id])
  messages       Message[]
  assignedMember TeamMember? @relation("AssignedConversations", fields: [assignedMemberId], references: [id])

  @@index([tenantId])
  @@index([customerId])
  @@index([waNumber])
  @@index([status])
  @@map("conversations")
}

model Message {
  id             String           @id @default(uuid())
  conversationId String
  direction      MessageDirection
  type           String           @default("text")
  content        Json             // { text, media, interactive, etc. }
  waMessageId    String?          @unique
  status         MessageStatus    @default(PENDING)
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([waMessageId])
  @@map("messages")
}

model Campaign {
  id              String         @id @default(uuid())
  tenantId        String
  name            String
  type            CampaignType
  status          CampaignStatus @default(DRAFT)
  targetSegment   Json           @default("{}")
  message         String
  mediaUrl        String?
  templateName    String?
  scheduledAt     DateTime?
  sentAt          DateTime?
  stats           Json           @default("{\"sent\":0,\"delivered\":0,\"read\":0,\"replied\":0}")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([scheduledAt])
  @@map("campaigns")
}

// Platform-level super admin (SocialCart operators)
model SuperAdmin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("super_admins")
}

// Team members within a tenant (agents, managers, sales reps)
model TeamMember {
  id           String    @id @default(uuid())
  tenantId     String
  name         String
  email        String?
  phone        String?
  passwordHash String
  role         TeamRole  @default(AGENT)
  managerId    String?   // null for OWNER/top-level MANAGER
  isActive     Boolean   @default(true)
  permissions  Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager               TeamMember?    @relation("TeamHierarchy", fields: [managerId], references: [id])
  reports               TeamMember[]   @relation("TeamHierarchy")
  assignedConversations Conversation[] @relation("AssignedConversations")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([managerId])
  @@map("team_members")
}

model LoyaltyAccount {
  id         String       @id @default(uuid())
  customerId String       @unique
  tenantId   String
  points     Int          @default(0)
  tier       LoyaltyTier  @default(BRONZE)
  history    Json         @default("[]")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("loyalty_accounts")
}

// WhatsApp OTP codes for tenant authentication
model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String   // 6-digit, stored hashed
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_codes")
}

// In-app + cross-channel notifications
model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  memberId  String?          // null = owner-level notification
  type      NotificationType
  title     String
  body      String
  data      Json             @default("{}")  // extra context (orderId, conversationId, etc.)
  read      Boolean          @default(false)
  channels  NotificationChannel[]
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, read])
  @@index([memberId])
  @@map("notifications")
}

// Payment links created at checkout and sent via WhatsApp
model PaymentLink {
  id           String            @id @default(uuid())
  tenantId     String
  customerId   String
  orderId      String?           // set once order is confirmed
  provider     PaymentProvider
  externalRef  String?           // Paystack/Flutterwave reference
  amount       Decimal           @db.Decimal(12, 2)
  currency     String            @default("NGN")
  url          String
  status       PaymentLinkStatus @default(PENDING)
  metadata     Json              @default("{}")
  expiresAt    DateTime
  paidAt       DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id])
  order    Order?    @relation(fields: [orderId], references: [id])

  @@index([tenantId])
  @@index([externalRef])
  @@index([status])
  @@map("payment_links")
}

// Web Push subscriptions (VAPID)
model PushSubscription {
  id        String   @id @default(uuid())
  tenantId  String
  memberId  String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([memberId])
  @@map("push_subscriptions")
}
